# Production URL
NEXT_PUBLIC_SITE_URL=https://greenwichgadgets.com

# Booking form emails (Resend)
# Repair requests from /book are emailed to the shop via Resend.
# Set your Resend API key here — that is the only value required.
RESEND_API_KEY=

# Optional overrides (sensible defaults are used if unset):
#   From address must be on a domain you've verified in Resend.
# BOOKING_FROM_EMAIL="Greenwich Gadgets <noreply@greenwichgadgets.com>"
# BOOKING_TO_EMAIL=greenwichgadgets@gmail.com

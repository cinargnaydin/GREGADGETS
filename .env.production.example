# Production URL
NEXT_PUBLIC_SITE_URL=https://greenwichgadgets.com

# Email notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=Greenwich Gadgets <onboarding@resend.dev>
BOOKING_NOTIFICATION_EMAIL=
QUOTE_RECEIVER_EMAIL=
LEAD_NOTIFICATION_EMAIL=
SEND_REAL_NOTIFICATIONS=true

# Google Calendar booking integration
# IMPORTANT: use a DEDICATED bookings-only calendar here, not a personal/shared
# one. Availability is derived from this calendar's busy times, so any personal
# events (especially all-day ones) would block customer slots. Create a new
# calendar, share it with GOOGLE_CALENDAR_CLIENT_EMAIL (Make changes to events),
# and paste that calendar's ID below.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=

# Firebase client config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase / Firestore server credentials
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional SMS confirmations
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Lead funnel is the single booking entry point (always on in code).
# LEAD_FUNNEL_PREVIEW_ENABLED only gates the internal /lead-funnel-preview route in production.
NEXT_PUBLIC_LEAD_FUNNEL_ENABLED=true
LEAD_FUNNEL_PREVIEW_ENABLED=false
